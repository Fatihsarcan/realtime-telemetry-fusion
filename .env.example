# Bu dosyayi ".env" olarak kopyalayin. .env repoya girmez.

# --- Veritabani / kuyruk kimlikleri ---
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=telemetry
POSTGRES_DB=telemetry
RABBITMQ_USER=telemetry
RABBITMQ_PASSWORD=telemetry

# --- API ---
API_PORT=8000
LOG_LEVEL=INFO

# --- OpenSky ---
# Bos birakilirsa anonim erisim kullanilir (dusuk kota ama calisir).
# Ucretsiz hesap: https://opensky-network.org/ -> Account -> API Client olustur
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Anonim erisimde 15 sn altina inmeyin, 429 yersiniz.
OPENSKY_POLL_INTERVAL_S=15
# lat_min,lat_max,lon_min,lon_max -- varsayilan: Turkiye ve cevresi
OPENSKY_BBOX=35.5,42.5,25.5,45.0

# --- Processor ---
PROCESSOR_BATCH_SIZE=500
PROCESSOR_BATCH_FLUSH_MS=1000
