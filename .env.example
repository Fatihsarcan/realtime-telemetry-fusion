# Bu dosyayi ".env" olarak kopyalayin. .env repoya girmez (.gitignore'da).
#
# GUVENLIK: Asagidaki parolalar yalnizca lokal gelistirme icindir. Bu servisler
# lokalde disariya hic acilmaz (yalnizca konteyner agi icinden erisilir).
# Sunucuya kurulumda `scripts/server-setup.sh` bunlarin yerine rastgele
# uretilmis parolalar yazar; uretimde bu degerler asla kullanilmaz.

# --- Veritabani / kuyruk kimlikleri (yalnizca lokal) ---
POSTGRES_USER=telemetry
POSTGRES_PASSWORD=lokal-gelistirme-parolasi-degistirin
POSTGRES_DB=telemetry
RABBITMQ_USER=telemetry
RABBITMQ_PASSWORD=lokal-gelistirme-parolasi-degistirin

# --- API ---
API_PORT=8000
LOG_LEVEL=INFO

# --- OpenSky ---
# Bos birakilirsa anonim erisim kullanilir (dusuk kota ama calisir).
# Ucretsiz hesap: https://opensky-network.org/ -> Account -> API Client olustur
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Anonim erisimde 15 sn altina inmeyin, 429 yersiniz.
OPENSKY_POLL_INTERVAL_S=15
# lat_min,lat_max,lon_min,lon_max -- varsayilan: Turkiye ve cevresi
OPENSKY_BBOX=35.5,42.5,25.5,45.0

# --- Uydu kaynagi (Celestrak) ---
# Anahtar veya hesap gerektirmez. TLE yorunge elemanlari saatlerce gecerlidir.
SATELLITE_GROUP=visual
SATELLITE_INTERVAL_S=10
TLE_REFRESH_S=21600

# --- Fuzyon / korelasyon ---
# Uydunun yer izdusumu bir ucaga bu mesafeden yakinsa eslesme uretilir.
CORRELATION_RADIUS_KM=250
CORRELATION_INTERVAL_S=30
CORRELATION_MAX_AGE_S=120

# --- Processor ---
PROCESSOR_BATCH_SIZE=500
PROCESSOR_BATCH_FLUSH_MS=1000

# --- Sinirlar (disk ve trafik korumasi) ---
# Bu sureden eski gozlemler otomatik silinir; disk suresiz buyumez.
RETENTION_DAYS=7
RETENTION_INTERVAL_S=3600
# Ayni anda kabul edilecek en fazla WebSocket istemcisi ve IP basina sinir.
# 50 istemci ~550 GB/ay cikis trafigi demek; ucretsiz kota 10 TB.
MAX_WS_CLIENTS=50
MAX_WS_PER_IP=5
